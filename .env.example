# ============================================================
# ALLYRA FRONTEND - Environment Variables
# ============================================================
# Copie este arquivo para .env e preencha os valores
# Para Vercel: Settings → Environment Variables
# ⚠️ Variáveis VITE_* são embutidas no build — requer redeploy após mudança
# ============================================================

# ----- Supabase (OBRIGATÓRIAS) -----
# Obter em: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=xxx

# ----- API Backend (OBRIGATÓRIA) -----
VITE_API_URL=https://allyra-backend.vercel.app

# ----- Ambiente (OBRIGATÓRIAS) -----
VITE_IS_PRODUCTION=true
VITE_APP_ENV=production

# ----- Feature Flags (opcionais) -----
VITE_ALLOW_SIGNUP=false
VITE_SHOW_API_DOCS=false
VITE_SHOW_DEV_MODULES=false
VITE_ENABLE_REALTIME=false

# ----- Scripts locais (scripts/create-dev-user.ts, apenas dev) -----
SUPABASE_SERVICE_ROLE_KEY=xxx
DEV_USER_EMAIL=dev@example.com
DEV_USER_PASSWORD=xxx
DEV_USER_NOME=Desenvolvedor
