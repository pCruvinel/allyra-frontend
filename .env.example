# Allyra - Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores

# ===================
# Supabase (obrigatório)
# ===================
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ===================
# Ambiente
# ===================
VITE_IS_PRODUCTION=false
VITE_APP_ENV=development
VITE_APP_NAME=Allyra
# No .env.local
VITE_ENABLE_REALTIME=false


# ===================
# Controle de Cadastro
# ===================
# Desabilita cadastro público e login social (Google/Apple)
# Use false enquanto fluxo de onboarding não está definido
VITE_ALLOW_SIGNUP=false

# ===================
# API Backend (obrigatório)
# ===================
# Define qual backend usar para a API
#
# Opção 1: Supabase Edge Functions (padrão em produção)
# VITE_API_URL=https://xxxxx.supabase.co/functions/v1/api-fastify
#
# Opção 2: API Node.js standalone - desenvolvimento local
# VITE_API_URL=http://localhost:3001
#
# Opção 3: API Node.js em produção (Railway, Render, etc.)
# VITE_API_URL=https://api.allyra.com.br
#
VITE_API_URL=http://localhost:3001

# ===================
# API Docs (opcional)
# ===================
# Exibe link para documentação da API no sidebar
# Apenas visível para admin_master e desenvolvedor
# Default: false (não exibe)
VITE_SHOW_API_DOCS=false
